# Quranic Linguistics Observatory - Environment Variables
# Copy this file to .env.local and fill in the values

# === Public site origin ===
# Used by metadata (canonicals, OG), sitemap.xml, robots.txt, JSON-LD, and the
# Supabase auth callback (lib/context/AuthContext.tsx).
#
# Must name the host the deployment actually SERVES — the apex 308s to www, so
# an apex value makes canonicals point at a redirect and sends the OAuth
# handshake through an extra hop. It must also match an entry in the Supabase
# project's Redirect URLs allow-list, or GoTrue discards the callback and falls
# back to that shared project's site_url (a sibling Pluragate app).
# Falls back to https://www.quranobservatory.org when unset.
# NEXT_PUBLIC_SITE_URL=https://www.quranobservatory.org

# === Feedback Email (Optional) ===
# Required only for the feedback form email delivery feature
BREVO_API_KEY=your_brevo_api_key_here
FEEDBACK_TO_EMAIL=info@pluragate.org
FEEDBACK_FROM_EMAIL=info@pluragate.org
FEEDBACK_FROM_NAME=Quranic Linguistics Observatory

# Fallback (used only if FEEDBACK_TO_EMAIL is not set)
# NEXT_PUBLIC_FEEDBACK_EMAIL=info@pluragate.org
# Supabase — required for all Supabase features
# Find these in: Supabase Dashboard → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Supabase service role — used ONLY in server-side scripts (seed)
# Never expose this to the browser or commit it to version control
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Anthropic — required for concept search (/api/search/concept).
# Claude expands a natural-language query into corpus terms (roots / lemmas /
# gloss keywords) that feed the client-side BM25F lexical ranker. No embeddings.
ANTHROPIC_API_KEY=sk-ant-...
# Model for concept expansion (default: claude-haiku-4-5 — fast + cheap)
CONCEPT_SEARCH_MODEL=claude-haiku-4-5

# OpenAI — required ONLY for image-assisted root extraction / OCR
# (/api/search/extract-root-image). Not used for text search.
OPENAI_API_KEY=sk-...
OPENAI_VISION_MODEL=gpt-4o-mini

# AI route rate limits (per app instance, per client IP)
CONCEPT_SEARCH_RATE_LIMIT_MAX=20
CONCEPT_SEARCH_RATE_LIMIT_WINDOW_MS=60000
IMAGE_ROOT_RATE_LIMIT_MAX=6
IMAGE_ROOT_RATE_LIMIT_WINDOW_MS=60000
MISTRAL_API_KEY=
# Gemini (Google AI Studio) — used by tools/lexicon/ocr_gemini.py
# NOTE: a Gemini Pro/Advanced consumer subscription is NOT API access.
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
